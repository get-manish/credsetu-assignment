PORT=4000
# Matches docker-compose.yml at the repo root
DATABASE_URL=postgres://miniledger:miniledger@localhost:5432/miniledger
# Used only by `npm test` (a separate DB so tests never touch demo data)
TEST_DATABASE_URL=postgres://miniledger:miniledger@localhost:5432/miniledger_test
# Change this to a long random string in any real deployment
JWT_SECRET=change-me-to-a-long-random-string
OTP_TTL_MINUTES=5
