{
  "expo": {
    "name": "MiniLedger",
    "slug": "miniledger",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "experiments": {
      "reactCompiler": true
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "MiniLedger needs access to your photos so you can attach a receipt.",
          "cameraPermission": "MiniLedger needs the camera so you can photograph a receipt."
        }
      ],
      "expo-secure-store"
    ],
    "android": {
      "package": "com.ranveersnig.miniledger"
    }
  }
}
